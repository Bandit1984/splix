{
	"tasks": {
		"dev": "deno run -A --watch scripts/dev.js",
		"dev-inspect": "deno run -A --inspect scripts/dev.js",
		"install-deps": "deno run -A scripts/dev.js --no-init",
		"check": "deno run --allow-env --allow-read npm:typescript@5.2.2/tsc --noEmit -p ./jsconfig.json",
		"build-gameserver": "deno run -A scripts/buildGameServer.js",
		"build-client": "deno run -A scripts/buildClient.js",
		"build-servermanager": "deno run -A scripts/buildServerManager.js",
		"build-adminpanel": "deno run -A scripts/buildAdminPanel.js",
		"train-ai": "deno run -A scripts/trainSelfPlay.js",
		"python-setup": "bash aitraining/scripts/setup_venv.sh",
		"python-train": "PYTHONPATH=. aitraining/.venv/bin/python -m aitraining.trainers.train_ppo",
		"python-train-subproc": "PYTHONPATH=. aitraining/.venv/bin/python -m aitraining.trainers.train_ppo --vector-mode subproc",
		"python-eval": "PYTHONPATH=. aitraining/.venv/bin/python -m aitraining.trainers.eval_ppo",
		"python-preflight": "PYTHONPATH=. aitraining/.venv/bin/python -m aitraining.trainers.preflight",
		"fmt": "deno fmt"
	},
	"importMap": "importmap.json",
	"lock": false,
	"fmt": {
		"exclude": [
			".denoTypes",
			"deps",
			"client/out",
			".github/workflows"
		],
		"indentWidth": 4,
		"useTabs": true,
		"lineWidth": 120,
		"proseWrap": "preserve"
	}
}
